package "br.com.encomendas.model.enums" {
  enum CanalOrigem {
    WHATSAPP
    INSTAGRAM
    PRESENCIAL
  }

  enum FormaPagamento {
    PIX
    CARTAO
    DINHEIRO
  }

  enum OrigemAprovacao {
    CLIENTE_VIA_LINK
    ATENDENTE
  }

  enum PerfilFuncionario {
    ATENDIMENTO
    PRODUCAO
    ENTREGA
    PROPRIETARIO
  }

  enum StatusPedido {
    RECEBIDO
    AGUARDANDO_MATERIAL
    EM_PRODUCAO
    PRONTO
    ENTREGUE
    CANCELADO
    +boolean podeIrPara(StatusPedido destino)
  }

  enum StatusVersao {
    PENDENTE_APROVACAO
    APROVADA
    INVALIDADA
  }

  enum TipoPagamento {
    SINAL
    PARCIAL
    RESTANTE
  }
}

' Relacionamentos com cardinalidade e papéis
Cliente "1" --> "0..*" Pedido : pedidos / cliente
Funcionario "1" --> "0..*" Pedido : pedidosAtendidos / atendente
Funcionario "1" --> "0..*" VersaoPedido : versoesCriadas / criadaPor
Funcionario "0..1" --> "0..*" VersaoPedido : versoesAprovadas / aprovador
Funcionario "1" --> "0..*" Pagamento : pagamentosRegistrados / registradoPor
DiaProducao "1" --> "0..*" Pedido : pedidos / diaProducao
Pedido "1" --> "0..*" VersaoPedido : versoes / pedido
Pedido "1" --> "0..*" Pagamento : pagamentos / pedido
Pedido "1" *-- "0..1" LinkAcompanhamento : linkAcompanhamento / pedido
VersaoPedido "1" --> "0..*" ItemPedido : itens / versaoPedido
Produto "1" --> "0..*" ItemPedido : itens / produto

' Relacionamentos de enumeração
Cliente "0..*" --> "1" CanalOrigem : canalOrigem
Funcionario "0..*" --> "1" PerfilFuncionario : perfil
Pedido "0..*" --> "1" StatusPedido : status
VersaoPedido "0..*" --> "1" StatusVersao : status
VersaoPedido "0..*" --> "0..1" OrigemAprovacao : origemAprovacao
Pagamento "0..*" --> "1" TipoPagamento : tipo
Pagamento "0..*" --> "1" FormaPagamento : forma

@enduml